@@ -0,0 +1,134 @@
+"""Google Business Profile: locations are listed with a readMask, picked one by
+one, and every post goes to the location the connection was made for."""
+
+from unittest.mock import MagicMock
+
+from providers.google_business import (
+    ACCOUNTS_API,
+    BUSINESS_INFO_API,
+    LOCATION_READ_MASK,
+    POSTS_API,
+    GoogleBusinessProvider,
+)
+from providers.types import PublishContent
+
+CREDS = {"client_id": "id", "client_secret": "secret"}
+
+
+def _resp(data):
+    return MagicMock(json=MagicMock(return_value=data))
+
+
+def _location(loc_id, title, address=None):
+    loc = {"name": f"locations/{loc_id}", "title": title}
+    if address:
+        loc["storefrontAddress"] = {"addressLines": address}
+    return loc
+
+
+def _router(routes):
+    """A _request stub answering by (url, pageToken)."""
+
+    def _request(method, url, **kwargs):
+        token = (kwargs.get("params") or {}).get("pageToken")
+        return _resp(routes[(url, token)])
+
+    return MagicMock(side_effect=_request)
+
+
+def test_locations_are_listed_with_a_read_mask_and_every_page_is_read():
+    provider = GoogleBusinessProvider(CREDS)
+    url = f"{BUSINESS_INFO_API}/accounts/1/locations"
+    provider._request = _router(
+        {
+            (url, None): {"locations": [_location(10, "First")], "nextPageToken": "p2"},
+            (url, "p2"): {"locations": [_location(11, "Second")]},
+        }
+    )
+
+    locations = provider._list_locations("token", "accounts/1")
+
+    assert [loc["title"] for loc in locations] == ["First", "Second"]
+    for call in provider._request.call_args_list:
+        assert call.kwargs["params"]["readMask"] == LOCATION_READ_MASK
+
+
+def test_the_picker_lists_every_location_of_every_account_once():
+    provider = GoogleBusinessProvider(CREDS)
+    provider._request = _router(
+        {
+            (f"{ACCOUNTS_API}/accounts", None): {
+                "accounts": [
+                    {"name": "accounts/1", "accountName": "Personal"},
+                    {"name": "accounts/2", "accountName": "Agency group"},
+                ]
+            },
+            (f"{BUSINESS_INFO_API}/accounts/1/locations", None): {
+                "locations": [_location(10, "Wad Up", ["Voorstraat 1", "Franeker"])]
+            },
+            (f"{BUSINESS_INFO_API}/accounts/2/locations", None): {
+                # A location can show up under its group as well as its owner.
+                "locations": [_location(10, "Wad Up"), _location(20, "Client")]
+            },
+        }
+    )
+
+    pages = provider.get_user_pages("token")
+
+    assert pages == [
+        {
+            "id": "accounts/1/locations/10",
+            "name": "Wad Up",
+            "category": "Voorstraat 1, Franeker",
+            "picture": None,
+        },
+        {
+            "id": "accounts/2/locations/20",
+            "name": "Client",
+            "category": "Agency group",
+            "picture": None,
+        },
+    ]
+
+
+def test_profile_of_a_connected_location_is_that_location():
+    provider = GoogleBusinessProvider({**CREDS, "account_id": "accounts/2", "location_id": "locations/20"})
+    provider._request = MagicMock(return_value=_resp(_location(20, "Client", ["Kerkstraat 5"])))
+
+    profile = provider.get_profile("token")
+
+    assert profile.platform_id == "accounts/2/locations/20"
+    assert profile.name == "Client"
+    assert profile.extra["address"] == "Kerkstraat 5"
+    provider._request.assert_called_once()
+    call = provider._request.call_args
+    assert call.args == ("GET", f"{BUSINESS_INFO_API}/locations/20")
+    assert call.kwargs["params"] == {"readMask": LOCATION_READ_MASK}
+
