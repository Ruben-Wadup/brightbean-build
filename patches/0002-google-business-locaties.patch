+"""Connecting Google Business Profile: the user picks locations, each one is
+driven by the user's grant, and disconnecting one leaves the others working."""
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+from django.contrib.messages import get_messages
+from django.urls import reverse
+
+from apps.social_accounts.models import SocialAccount
+from apps.social_accounts.views import OAUTH_SESSION_KEY, _sign_state
+from providers.types import OAuthTokens
+
+
+@pytest.fixture
+def workspace(db, organization):
+    from apps.workspaces.models import Workspace
+
+    return Workspace.objects.create(name="Test WS", organization=organization)
+
+
+@pytest.fixture
+def authenticated_client(client, user, organization, workspace):
+    from apps.members.models import OrgMembership, WorkspaceMembership
+
+    OrgMembership.objects.create(user=user, organization=organization, org_role="owner")
+    WorkspaceMembership.objects.create(user=user, workspace=workspace, workspace_role="manager")
+    client.force_login(user)
+    return client
+
+
+def _callback(client, workspace, user, provider):
+    nonce = "nonce-gbp"
+    state = _sign_state(workspace.id, "google_business", user.id, nonce)
+    session = client.session
+    session[OAUTH_SESSION_KEY] = {"nonce": nonce}
+    session.save()
+    url = reverse("social_accounts:oauth_callback", kwargs={"platform": "google_business"})
+    with patch("apps.social_accounts.views._get_provider_for_platform", return_value=provider):
+        return client.get(url, {"code": "abc", "state": state})
+
+
+def test_callback_sends_the_user_to_the_location_picker(authenticated_client, workspace, user):
+    provider = MagicMock()
+    provider.exchange_code.return_value = OAuthTokens(
+        access_token="user-token", refresh_token="refresh", expires_in=3599
+    )
+    provider.get_user_pages.return_value = [
+        {"id": "accounts/1/locations/10", "name": "Wad Up", "category": "Franeker", "picture": None},
+        {"id": "accounts/2/locations/20", "name": "Client", "category": "Agency", "picture": None},
+    ]
+
+    response = _callback(authenticated_client, workspace, user, provider)
+
+    assert response.status_code == 302
+    assert response.url == reverse("social_accounts:select_account")
+    provider.get_profile.assert_not_called()
+    provider.refresh_token.assert_not_called()
+    page_data = authenticated_client.session["oauth_page_select"]
+    assert page_data["platform"] == "google_business"
+    assert [p["id"] for p in page_data["pages"]] == ["accounts/1/locations/10", "accounts/2/locations/20"]
+    assert page_data["user_tokens"]["expires_in"] == 3599
+
+    picker = authenticated_client.get(reverse("social_accounts:select_account"))
+    assert b"Google Business Profile login" in picker.content
+    assert b"Client" in picker.content
+
+
+def test_callback_without_locations_explains_why(authenticated_client, workspace, user):
+    provider = MagicMock()
+    provider.exchange_code.return_value = OAuthTokens(access_token="user-token", refresh_token="refresh")
+    provider.get_user_pages.return_value = []
+
+    response = _callback(authenticated_client, workspace, user, provider)
+
+    assert response.status_code == 302
+    assert not SocialAccount.objects.filter(platform="google_business").exists()
+    texts = [str(m) for m in get_messages(response.wsgi_request)]
+    assert any("No Google Business Profile locations" in t for t in texts)
+
+
+def test_only_the_picked_location_is_connected_on_the_users_grant(authenticated_client, workspace):
+    session = authenticated_client.session
+    session["oauth_page_select"] = {
+        "workspace_id": str(workspace.id),
+        "platform": "google_business",
+        "user_tokens": {"access_token": "user-token", "refresh_token": "refresh", "expires_in": 3599},
+        "pages": [
+            {"id": "accounts/1/locations/10", "name": "Wad Up", "category": "Franeker", "picture": None},
+            {"id": "accounts/2/locations/20", "name": "Client", "category": "Agency", "picture": None},
+        ],
+    }
+    session.save()
+
+    response = authenticated_client.post(
+        reverse("social_accounts:select_account"), {"selected_pages": ["accounts/1/locations/10"]}
+    )
+
+    assert response.status_code == 302
+    account = SocialAccount.objects.get(workspace=workspace, platform="google_business")
+    assert account.account_platform_id == "accounts/1/locations/10"
+    assert account.account_name == "Wad Up"
+    assert account.oauth_access_token == "user-token"
+    assert account.oauth_refresh_token == "refresh"
+    assert account.token_expires_at is not None
+
+
+def _gbp(workspace, platform_id, refresh):
+    return SocialAccount.objects.create(
+        workspace=workspace,
+        platform="google_business",
+        account_platform_id=platform_id,
+        account_name=platform_id,
+        oauth_access_token="access",
+        oauth_refresh_token=refresh,
+    )
+
+
+def _disconnect(client, workspace, account):
+    url = reverse("social_accounts:disconnect", kwargs={"workspace_id": workspace.id, "account_id": account.id})
+    with (
+        patch("apps.social_accounts.views.unsubscribe_account_webhooks"),
+        patch("providers.get_provider") as get_provider,
+    ):
+        response = client.post(url)
+    assert response.status_code == 302
+    return get_provider.return_value.revoke_token
+
+
+def test_disconnecting_one_location_keeps_the_shared_grant(authenticated_client, workspace):
+    first = _gbp(workspace, "accounts/1/locations/10", "shared-refresh")
+    second = _gbp(workspace, "accounts/1/locations/11", "shared-refresh")
+
+    revoke = _disconnect(authenticated_client, workspace, first)
+
+    revoke.assert_not_called()
+    assert SocialAccount.objects.filter(pk=second.pk).exists()
+
+
+def test_the_last_location_on_a_grant_revokes_it(authenticated_client, workspace):
+    _gbp(workspace, "accounts/9/locations/90", "other-refresh")
+    last = _gbp(workspace, "accounts/1/locations/10", "shared-refresh")
+
+    revoke = _disconnect(authenticated_client, workspace, last)
+
+    revoke.assert_called_once_with("shared-refresh")
