+def test_a_post_goes_to_the_connected_location_under_its_account():
+    provider = GoogleBusinessProvider({**CREDS, "account_id": "accounts/2", "location_id": "locations/20"})
+    provider._request = MagicMock(return_value=_resp({"name": "accounts/2/locations/20/localPosts/99"}))
+
+    result = provider.publish_post("token", PublishContent(text="Open op zaterdag"))
+
+    provider._request.assert_called_once()
+    call = provider._request.call_args
+    assert call.args == ("POST", f"{POSTS_API}/accounts/2/locations/20/localPosts")
