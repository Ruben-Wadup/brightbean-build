+def test_profile_without_a_connection_falls_back_to_the_first_location():
+    provider = GoogleBusinessProvider(CREDS)
+    provider._request = _router(
+        {
+            (f"{ACCOUNTS_API}/accounts", None): {"accounts": [{"name": "accounts/1"}]},
+            (f"{BUSINESS_INFO_API}/accounts/1/locations", None): {"locations": [_location(10, "Wad Up")]},
+        }
+    )
+
+    profile = provider.get_profile("token")
+
+    assert profile.platform_id == "accounts/1/locations/10"
