+"""Publishing, the health check and the inbox all reach a Google Business
+connection through its own location, never the first one the grant can see."""
+
+import pytest
+
+from apps.publisher.engine import _resolve_publish_credentials
+from apps.social_accounts.models import SocialAccount
+
+
+@pytest.fixture
+def workspace(db, organization):
+    from apps.workspaces.models import Workspace
+
+    return Workspace.objects.create(name="WS", organization=organization)
+
+
+def _account(workspace, platform_id):
+    return SocialAccount.objects.create(
+        workspace=workspace,
+        platform="google_business",
+        account_platform_id=platform_id,
+        account_name="Location",
+        oauth_access_token="token",
+    )
+
+
+def test_the_connected_location_is_passed_to_the_provider(workspace):
+    credentials = _resolve_publish_credentials(_account(workspace, "accounts/2/locations/20"))
+
+    assert credentials["account_id"] == "accounts/2"
+    assert credentials["location_id"] == "locations/20"
+
+
+@pytest.mark.parametrize("platform_id", ["locations/20", "accounts/2", ""])
+def test_an_id_without_account_and_location_sets_neither(workspace, platform_id):
+    credentials = _resolve_publish_credentials(_account(workspace, platform_id))
+
+    assert "account_id" not in credentials
+    assert "location_id" not in credentials
