+def _grant_is_shared(account) -> bool:
+    """Whether another connection runs on the same Google grant as ``account``.
+
+    Locations picked from one Google Business login all carry that login's
+    refresh token, and revoking it revokes the grant for every one of them.
+    Disconnecting one location must leave the others working, so the grant is
+    only revoked together with the last connection that uses it.
+    """
+    if account.platform != PlatformCredential.Platform.GOOGLE_BUSINESS or not account.oauth_refresh_token:
+        return False
+    # The token column is encrypted, so compare in Python, not in SQL.
+    others = SocialAccount.objects.filter(platform=account.platform).exclude(pk=account.pk)
+    return any(other.oauth_refresh_token == account.oauth_refresh_token for other in others)
+
