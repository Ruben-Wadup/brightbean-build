+"""Google Business Profile button and language in the composer.
+
+Same marker contract as the Facebook and Instagram panels: only a submit that
+carries ``google_business_panel_<id>`` may change the stored settings.
+"""
+
+from django.test import override_settings
+from django.urls import reverse
+
+from apps.composer.models import PlatformPost
+from apps.composer.tests.test_account_scope import AccountScopeTestsBase
+from apps.social_accounts.models import SocialAccount
+
+OK_STATUSES = (200, 204, 302)
+
+
+class GoogleBusinessSettingsTests(AccountScopeTestsBase):
+    def setUp(self):
+        super().setUp()
+        self.gbp = SocialAccount.objects.create(
+            workspace=self.workspace,
+            platform="google_business",
+            account_platform_id="accounts/1/locations/10",
+            account_name="Location",
+            connection_status=SocialAccount.ConnectionStatus.CONNECTED,
+        )
+        self.gbp_pp = PlatformPost.objects.create(
+            post=self.post,
+            social_account=self.gbp,
+            status=PlatformPost.Status.DRAFT,
+        )
+
+    def _gbp_payload(self, panel=True, **values):
+        account_id = str(self.gbp.id)
+        fields = {f"google_business_panel_{account_id}": "1"} if panel else {}
+        for key, value in values.items():
+            fields[f"gbp_{key}_{account_id}"] = value
+        return self._payload(selected_accounts=account_id, account_scope=account_id, **fields)
+
+    def _save(self, data):
+        response = self.client.post(self.save_url, data=data)
+        self.assertIn(response.status_code, OK_STATUSES)
+        self.gbp_pp.refresh_from_db()
+
+    def test_button_link_and_language_round_trip_into_platform_extra(self):
+        self._save(self._gbp_payload(cta_type="BOOK", link_url="https://example.com/a", language_code="nl"))
+
+        self.assertEqual(
+            self.gbp_pp.platform_extra,
+            {"cta_type": "BOOK", "link_url": "https://example.com/a", "language_code": "nl"},
+        )
+
+    def test_no_button_clears_an_earlier_one_and_keeps_other_extras(self):
+        self.gbp_pp.platform_extra = {"cta_type": "BOOK", "link_url": "https://example.com/a", "topic_type": "STANDARD"}
+        self.gbp_pp.save(update_fields=["platform_extra"])
+
+        self._save(self._gbp_payload(cta_type="", link_url="https://example.com/a", language_code="nl"))
+
+        self.assertEqual(self.gbp_pp.platform_extra, {"topic_type": "STANDARD", "language_code": "nl"})
+
+    def test_a_button_without_a_web_link_is_not_stored(self):
+        for link in ("", "example.com/a", "javascript:alert(1)", "ftp://example.com/a"):
+            with self.subTest(link=link):
+                self._save(self._gbp_payload(cta_type="LEARN_MORE", link_url=link))
+
+                self.assertNotIn("cta_type", self.gbp_pp.platform_extra or {})
+                self.assertNotIn("link_url", self.gbp_pp.platform_extra or {})
+
+    def test_an_unknown_button_or_language_is_not_stored(self):
+        self._save(self._gbp_payload(cta_type="CALL", link_url="https://example.com/a", language_code="xx"))
+
+        self.assertEqual(self.gbp_pp.platform_extra, {})
+
+    def test_a_save_without_the_panel_leaves_the_settings_alone(self):
+        saved = {"cta_type": "BOOK", "link_url": "https://example.com/a", "language_code": "nl"}
+        self.gbp_pp.platform_extra = saved
+        self.gbp_pp.save(update_fields=["platform_extra"])
+
+        self._save(self._gbp_payload(panel=False))
+
+        self.assertEqual(self.gbp_pp.platform_extra, saved)
+
+    @override_settings(GOOGLE_BUSINESS_LANGUAGE_CODE="nl")
+    def test_the_composer_offers_the_panel_with_the_default_language(self):
+        compose_url = reverse("composer:compose", kwargs={"workspace_id": self.workspace.id})
+
+        response = self.client.get(compose_url)
+
+        self.assertContains(response, "Google Business Settings")
+        self.assertContains(response, '<option value="nl">Dutch</option>')
+        self.assertContains(response, "language_code || 'nl'")
