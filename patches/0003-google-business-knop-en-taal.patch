diff --git a/tests/providers/test_google_business_cta.py b/tests/providers/test_google_business_cta.py
new file mode 100644
index 0000000..d777369
--- /dev/null
+++ b/tests/providers/test_google_business_cta.py
@@ -0,0 +1,54 @@
+"""Google Business Profile: a link becomes the post's button, and the post
+carries the language it was written in."""
+
+from unittest.mock import MagicMock
+
+import pytest
+
+from providers.google_business import CTA_ACTION_TYPES, GoogleBusinessProvider
+from providers.types import PostType, PublishContent
+
+CREDS = {
+    "client_id": "id",
+    "client_secret": "secret",
+    "account_id": "accounts/1",
+    "location_id": "locations/10",
+}
+
+
+def _publish(**content_kwargs):
+    provider = GoogleBusinessProvider(CREDS)
+    provider._request = MagicMock(return_value=MagicMock(json=MagicMock(return_value={"name": "p"})))
+    content = PublishContent(text="Hello", post_type=PostType.TEXT, **content_kwargs)
+    provider.publish_post("token", content)
+    return provider._request.call_args.kwargs["json"]
+
+
+@pytest.mark.parametrize("action_type", CTA_ACTION_TYPES)
+def test_a_link_is_sent_as_the_chosen_button(action_type):
+    body = _publish(link_url="https://example.com/a", extra={"cta_type": action_type})
+
+    assert body["callToAction"] == {"actionType": action_type, "url": "https://example.com/a"}
+
+
+def test_a_link_without_a_chosen_button_gets_learn_more():
+    body = _publish(link_url="https://example.com/a", extra={})
+
+    assert body["callToAction"] == {"actionType": "LEARN_MORE", "url": "https://example.com/a"}
+
+
+@pytest.mark.parametrize("action_type", ["CALL", "bogus"])
+def test_an_unusable_button_type_falls_back_to_learn_more(action_type):
+    body = _publish(link_url="https://example.com/a", extra={"cta_type": action_type})
+
+    assert body["callToAction"]["actionType"] == "LEARN_MORE"
+
+
+def test_no_link_means_no_button():
+    body = _publish(extra={"cta_type": "BOOK"})
+
+    assert "callToAction" not in body
+
+
+def test_the_post_carries_its_language():
+    assert _publish(extra={"language_code": "nl"})["languageCode"] == "nl"
