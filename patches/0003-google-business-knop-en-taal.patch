@@ -0,0 +1,70 @@
+"""A Google Business post without a language of its own gets the instance
+default (GOOGLE_BUSINESS_LANGUAGE_CODE), not a hard-coded "en"."""
+
+from unittest.mock import MagicMock, patch
+
+from django.test import SimpleTestCase, override_settings
+
+from apps.publisher.engine import PublishEngine
+from providers.types import AuthType, PostType, PublishResult
+
+
+def _mocks(platform, platform_extra):
+    account = MagicMock()
+    account.platform = platform
+    account.account_platform_id = "accounts/1/locations/10"
+    account.token_expires_at = None
+    account.oauth_access_token = "tok"
+    account.account_name = "Location"
+
+    platform_post = MagicMock()
+    platform_post.social_account = account
+    platform_post.post.media_attachments.select_related.return_value.order_by.return_value = []
+    platform_post.post.tags = []
+    platform_post.effective_caption = "hello"
+    platform_post.effective_title = None
+    platform_post.effective_first_comment = None
+    platform_post.platform_extra = platform_extra
+
+    provider = MagicMock()
+    provider.auth_type = AuthType.OAUTH2
+    provider.supported_post_types = [PostType.TEXT]
+    provider.needs_local_media = False
+    provider.publish_is_async = False
+    provider.publish_post.return_value = PublishResult(platform_post_id="p1", url=None, extra={})
+    return platform_post, provider
+
+
+@override_settings(GOOGLE_BUSINESS_LANGUAGE_CODE="nl")
+@patch("apps.publisher.engine._resolve_publish_credentials", return_value={})
+@patch("apps.publisher.engine.get_provider")
+class GoogleBusinessLanguageTest(SimpleTestCase):
+    def _content(self, get_provider, platform, platform_extra):
+        platform_post, provider = _mocks(platform, platform_extra)
+        get_provider.return_value = provider
+        PublishEngine()._dispatch_to_provider(platform_post)
+        _token, content = provider.publish_post.call_args.args
+        return content
+
+    def test_a_post_without_a_language_gets_the_instance_default(self, get_provider, _creds):
+        content = self._content(get_provider, "google_business", {})
+
+        self.assertEqual(content.extra["language_code"], "nl")
+
+    def test_a_chosen_language_is_kept(self, get_provider, _creds):
+        content = self._content(get_provider, "google_business", {"language_code": "de"})
+
+        self.assertEqual(content.extra["language_code"], "de")
+
+    def test_the_button_link_reaches_the_provider(self, get_provider, _creds):
+        content = self._content(
+            get_provider, "google_business", {"cta_type": "BOOK", "link_url": "https://example.com/a"}
+        )
+
+        self.assertEqual(content.link_url, "https://example.com/a")
+        self.assertEqual(content.extra["cta_type"], "BOOK")
+
+    def test_other_platforms_get_no_language(self, get_provider, _creds):
+        content = self._content(get_provider, "facebook", {})
+
+        self.assertNotIn("language_code", content.extra)
